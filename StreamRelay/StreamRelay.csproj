<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <None Update="relay.yml"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Condition="'$(MediaMtxDirectory)' == ''"
          Update="MediaMTX/mediamtx.exe;MediaMTX/LICENSE"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Condition="'$(MediaMtxDirectory)' != ''"
          Include="$(MediaMtxDirectory)/mediamtx.exe;$(MediaMtxDirectory)/LICENSE"
          Link="MediaMTX/%(Filename)%(Extension)" CopyToPublishDirectory="Always" />
  </ItemGroup>

</Project>
