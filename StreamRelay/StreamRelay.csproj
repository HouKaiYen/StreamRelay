<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>1.0.2</Version>
    <ApplicationIcon>Assets\StreamRelay.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="Assets/StreamRelay.ico" />
    <None Update="relay.yml"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Condition="'$(MediaMtxDirectory)' == ''"
          Update="MediaMTX/mediamtx.exe;MediaMTX/LICENSE"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Condition="'$(MediaMtxDirectory)' != ''"
          Include="$(MediaMtxDirectory)/mediamtx.exe;$(MediaMtxDirectory)/LICENSE"
          Link="MediaMTX/%(Filename)%(Extension)" CopyToPublishDirectory="Always" />
  </ItemGroup>

  <Target Name="CopyRuntimeNotices" AfterTargets="Publish" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <RuntimeNotice Include="%(ResolvedRuntimePack.PackageDirectory)/LICENSE.TXT"
                     Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'"
                     TargetPath="dotnet-runtime-license.txt" />
      <RuntimeNotice Include="%(ResolvedRuntimePack.PackageDirectory)/THIRD-PARTY-NOTICES.TXT"
                     Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'"
                     TargetPath="dotnet-runtime-third-party-notices.txt" />
      <RuntimeNotice Include="%(ResolvedRuntimePack.PackageDirectory)/LICENSE"
                     Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.WindowsDesktop.App'"
                     TargetPath="dotnet-windows-desktop-license.txt" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeNotice)"
          DestinationFiles="@(RuntimeNotice->'$(PublishDir)Licenses/%(TargetPath)')" />
  </Target>

</Project>
